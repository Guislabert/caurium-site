{
  "name": "caurium-site",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "npx serve dist",
    "lint": "eslint .",
    "typecheck": "astro check",
    "test": "node --import tsx --test tests/*.test.ts",
    "brand": "node scripts/generate-brand.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm check:links",
    "deploy:dev": "wrangler deploy --config wrangler.dev.jsonc",
    "check:branches": "node scripts/check-branches.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/roboto-slab": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "9.39.1",
    "@types/node": "^26.6.5",
    "eslint": "9.39.1",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "serve": "^14.2.6",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "wrangler": "^4.155.0"
  }
}
