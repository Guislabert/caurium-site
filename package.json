{
  "name": "caurium-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/generate-feed.mjs && node --import tsx scripts/generate-llms.mjs && next build",
    "start": "npx serve out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "brand": "node scripts/generate-brand.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm check:links",
    "feed": "node scripts/generate-feed.mjs",
    "llms": "node --import tsx scripts/generate-llms.mjs",
    "deploy:dev": "wrangler deploy --config wrangler.dev.jsonc",
    "check:branches": "node scripts/check-branches.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/roboto-slab": "^5.3.0",
    "next": "16.4.3",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "9.39.1",
    "eslint-config-next": "^16.4.3",
    "serve": "^14.2.6",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "wrangler": "^4.155.0"
  }
}
