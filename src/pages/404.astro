---
import CauriumLayout from '~/layouts/CauriumLayout.astro';
import Button from '~/components/caurium/Button.astro';

const metadata = {
  title: 'Page not found',
  description: 'The page you requested does not exist.',
  robots: { index: false, follow: false },
};
---

<CauriumLayout metadata={metadata}>
  <section class="page-hero">
    <div class="page-hero__glow" aria-hidden="true"></div>
    <div class="u-container">
      <div class="page-hero__copy">
        <p class="u-eyebrow">404</p>
        <h1 class="u-display-lg">This page does not hold.</h1>
        <p class="u-lead">
          The URL is wrong, or the page moved. The platform, pricing, and docs are still where you left them.
        </p>
        <div class="hero__actions">
          <Button href="/" arrow>Back to home</Button>
          <Button href="/pricing" variant="ghost">See pricing</Button>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="u-container">
      <div class="grid-3">
        <a class="card" href="/base">
          <span class="card__index">01</span>
          <h2 class="card__title">Base</h2>
          <p class="card__text">Managed hosting in five regions.</p>
        </a>
        <a class="card" href="/probe">
          <span class="card__index">02</span>
          <h2 class="card__title">Probe</h2>
          <p class="card__text">Synthetic monitoring and status pages.</p>
        </a>
        <a class="card" href="/guard">
          <span class="card__index">03</span>
          <h2 class="card__title">Guard</h2>
          <p class="card__text">Backups, standby, and tested failover.</p>
        </a>
      </div>
    </div>
  </section>
</CauriumLayout>
