---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Contact',
  description: 'Contact AsterLyn about access, regional setup, security reports, and partnerships.',
};

const email = 'hello' + '@' + 'asterlyn' + '.io';
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Contact"
    title="Talk to us"
    subtitle="Tell us what you run today, where your users are, and what you need from an edge layer. A short note is enough to start."
  />

  <Features2
    title="Where to reach us"
    subtitle="We read every message. Expect a reply within two business days."
    columns={2}
    items={[
      {
        title: 'Access and onboarding',
        description: `Questions about availability, regions, or migrating an existing API: <a class="text-primary underline" href="mailto:${email}">${email}</a>.`,
        icon: 'tabler:mail',
      },
      {
        title: 'Security',
        description: `Report a vulnerability or request our security contact details: <a class="text-primary underline" href="mailto:${email}">${email}</a>. Please do not include exploit details in a first message.`,
        icon: 'tabler:shield-lock',
      },
      {
        title: 'Partnerships',
        description: `Infrastructure, integration, or reseller questions: <a class="text-primary underline" href="mailto:${email}">${email}</a>.`,
        icon: 'tabler:users',
      },
      {
        title: 'Everything else',
        description: `Press, careers, or general questions: <a class="text-primary underline" href="mailto:${email}">${email}</a>.`,
        icon: 'tabler:message-circle',
      },
    ]}
  />

  <CallToAction
    title="Send us a note"
    subtitle="Include your current setup, the regions you care about, and roughly how much traffic you move."
    actions={[
      {
        variant: 'primary',
        text: 'Email AsterLyn',
        href: `mailto:${email}`,
        icon: 'tabler:mail',
      },
    ]}
    layout="banner"
  />
</Layout>
