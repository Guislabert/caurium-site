---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import { BUILD_LOG } from '@/content/build-log';

const TYPE_LABELS = {
  content: 'Content',
  docs: 'Documentation',
  design: 'Design',
  release: 'Release',
} as const;
---

<BaseLayout
  title="Build log"
  description="A dated record of what changed on the Caurium public site, what was corrected, what was removed and what is still missing, with an RSS feed."
  path="/build-log/"
  ogImage="/og/build-log.png"
  ogAlt="Caurium build log."
>
  <Fragment slot="head">
    <link rel="alternate" type="application/rss+xml" title="Caurium build log" href="/build-log/feed.xml" />
  </Fragment>

  <PageHero
    crumbs={[{ label: 'Build log' }]}
    title="A dated record of what changed."
    description="Every entry states what changed, where to check it, and whether it affected a public claim. This is the follow surface for the project; there is no newsletter."
  >
    <Fragment slot="meta">
      <a href="/build-log/feed.xml" class="link-arrow">
        RSS feed
        <span aria-hidden="true">→</span>
      </a>
    </Fragment>
  </PageHero>

  <section class="section border-b border-border" aria-labelledby="entries-heading">
    <div class="container-page">
      <div>
        <h2 id="entries-heading" class="h2 max-w-[16ch]">Newest first.</h2>
        <p class="note mt-5 text-[14px] leading-6 text-muted">
          A build log is not a release announcement. An entry can record a correction, a removal, or a
          gap that is still open.
        </p>
      </div>

      <ol class="mt-10 max-w-[46rem] border-t border-border-strong">
        {
          BUILD_LOG.map((entry) => (
            <li class="border-b border-border py-6">
              <div class="flex flex-wrap items-center gap-3">
                <time
                  datetime={entry.date}
                  class="mono text-[11px] uppercase tracking-[0.06em] text-muted"
                >
                  {entry.date}
                </time>
                <span class="badge-stage" data-stage="planned">
                  <span class="badge-dot" aria-hidden="true" />
                  {TYPE_LABELS[entry.type]}
                </span>
              </div>
              <h3 class="mt-3 text-[16px] font-medium leading-6">{entry.title}</h3>
              <p class="note mt-1.5 text-[14px] leading-6 text-muted">{entry.detail}</p>
              {entry.href && entry.linkLabel ? (
                <a href={entry.href} class="link-arrow mt-4">
                  {entry.linkLabel}
                  <span aria-hidden="true">→</span>
                </a>
              ) : null}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="not-heading">
    <div class="container-page grid gap-10 lg:grid-cols-[minmax(0,0.68fr)_minmax(0,1.32fr)] lg:gap-20">
      <div>
        <h2 id="not-heading" class="h2 max-w-[16ch]">Not a roadmap with dates.</h2>
      </div>
      <div class="space-y-5 text-[14px] leading-7 text-muted">
        <p>
          The log records changes that already happened. It does not promise a release date, and an
          entry is not evidence that a product is available.
        </p>
        <p>
          Product stages live in the <a href="/docs/product-stages/" class="text-link"
            >stage dictionary</a
          >. Claims and their evidence live in the <a href="/trust/" class="text-link"
            >claims register</a
          >.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
