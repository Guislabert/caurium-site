---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import ProductCard from '@/components/ProductCard.astro';
import {
  PRODUCTS,
  STAGE_CTA_ALLOWED,
  STAGE_DESCRIPTIONS,
  STAGE_LABELS,
  type ProductStage,
} from '@/content/products';

const STAGES = Object.keys(STAGE_LABELS) as ProductStage[];
---

<BaseLayout
  title="Products — roadmap and stages"
  description="Probe is in private preview for endpoint monitoring. Gate for scoped API access, Guard for operational safeguards, and Box for invitation-only development environments remain planned."
  path="/products/"
  ogImage="/og/products.png"
  ogAlt="Caurium products — Probe in private preview, three modules in development."
>
  <PageHero
    crumbs={[{ label: 'Products' }]}
    title="A focused roadmap, one module at a time."
    description="Caurium has four narrow modules. Probe is in private preview with manual activation. Gate and Guard are in development; Box is planned. Each page states the workflow, the limits, and the evidence required before its stage can change."
  >
    <Fragment slot="meta">
      <span class="badge-stage" data-stage="private-preview">
        <span class="badge-dot" aria-hidden="true"></span>
        Probe in private preview
      </span>
      <span class="mono text-[11px] uppercase tracking-[0.06em] text-muted">
        Reviewed 29 Oct 2026
      </span>
    </Fragment>
  </PageHero>

  <section class="section border-b border-border" aria-labelledby="modules-heading">
    <div class="container-page">
      <h2 id="modules-heading" class="sr-only">The four Caurium modules</h2>

      <div class="mt-8 grid gap-4 md:grid-cols-2 md:gap-5">
        {PRODUCTS.map((product, index) => <ProductCard product={product} index={index} />)}
      </div>

      <p class="note mt-5 text-[13px] leading-5 text-muted">
        Probe is in private preview. Gate and Guard are in development; Box is planned and not for
        sale.
      </p>
    </div>
  </section>

  <section class="section border-b border-border bg-paper" aria-labelledby="choose-heading">
    <div class="container-page grid gap-10 lg:grid-cols-[minmax(0,0.68fr)_minmax(0,1.32fr)] lg:gap-20">
      <div>
        <h2 id="choose-heading" class="h2 max-w-[15ch]">
          Start from the failure, not the product name.
        </h2>
        <p class="mt-5 note max-w-sm text-[14px] leading-6 text-muted">
          Each module exists because one failure mode is easy to leave unverified. Pick the sentence
          that sounds familiar.
        </p>
      </div>

      <div class="border-t border-border-strong">
        {
          [
            {
              problem: 'You cannot revoke one caller without breaking another.',
              product: 'Gate',
              href: '/products/gate/',
            },
            {
              problem: 'You learn about downtime from a customer, not from a check.',
              product: 'Probe',
              href: '/products/probe/',
            },
            {
              problem: 'You cannot prove that the last backup can be restored.',
              product: 'Guard',
              href: '/products/guard/',
            },
            {
              problem: 'A shared development environment has outlived its project.',
              product: 'Box',
              href: '/products/box/',
            },
            {
              problem: 'You are deciding whether to rely on any of this.',
              product: 'Product stages',
              href: '/docs/product-stages/',
            },
          ].map((row) => (
            <a
              href={row.href}
              class="group flex items-start justify-between gap-6 border-b border-border py-5 transition-colors hover:bg-background"
            >
              <span class="max-w-xl text-[14px] leading-6 text-ink-2">{row.problem}</span>
              <span class="link-arrow shrink-0">
                {row.product}
                <span aria-hidden="true">→</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section border-b border-border" aria-labelledby="stages-heading">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,0.7fr)_minmax(0,1.3fr)] lg:gap-20">
        <div>
          <h2 id="stages-heading" class="h2 max-w-[14ch]">A label is a statement of evidence.</h2>
          <p class="mt-5 note max-w-sm text-[14px] leading-6 text-muted">
            Status is stored once and reused by the home page, product pages, documentation and
            metadata. A module can move forward only when its own acceptance criteria are met.
          </p>
        </div>

        <div class="min-w-0">
          <ol
            class="grid grid-cols-2 gap-px overflow-hidden rounded-[10px] border border-border bg-border sm:grid-cols-3 lg:grid-cols-6"
          >
            {
              STAGES.map((stage, index) => {
                const current = stage === 'private-preview';
                return (
                  <li class={`p-3 ${current ? 'bg-accent-soft' : 'bg-paper'}`}>
                    <p class="mono text-[11px] uppercase tracking-[0.06em] text-muted">
                      {String(index + 1).padStart(2, '0')}
                    </p>
                    <p
                      class={`mt-1.5 text-[12px] font-medium leading-4 ${current ? 'text-accent-ink' : ''}`}
                    >
                      {STAGE_LABELS[stage]}
                    </p>
                    <p class="mono mt-1 text-[11px] uppercase tracking-[0.06em] text-muted">
                      {current ? 'Current' : 'Later'}
                    </p>
                  </li>
                );
              })
            }
          </ol>

          <div class="table-scroll mt-6">
            <table class="w-full border-collapse text-sm">
              <caption class="sr-only">
                Current stage, meaning and permitted call to action for each Caurium module
              </caption>
              <thead>
                <tr class="border-y border-border bg-background text-left">
                  <th scope="col" class="px-3 py-3 font-medium">Module</th>
                  <th scope="col" class="px-3 py-3 font-medium">Stage</th>
                  <th scope="col" class="px-3 py-3 font-medium">What that means</th>
                  <th scope="col" class="px-3 py-3 font-medium">Permitted CTA</th>
                </tr>
              </thead>
              <tbody>
                {
                  PRODUCTS.map((product) => (
                    <tr class="border-b border-border align-top">
                      <th scope="row" class="whitespace-nowrap px-3 py-4 text-left font-medium">
                        <a href={`/products/${product.slug}/`} class="text-accent-ink hover:underline">
                          {product.name}
                        </a>
                      </th>
                      <td class="whitespace-nowrap px-3 py-4 text-muted">
                        {STAGE_LABELS[product.stage]}
                      </td>
                      <td class="px-3 py-4 text-muted">{STAGE_DESCRIPTIONS[product.stage]}</td>
                      <td class="px-3 py-4 text-muted">{STAGE_CTA_ALLOWED[product.stage]}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-paper" aria-labelledby="not-heading">
    <div class="container-page grid gap-10 lg:grid-cols-[minmax(0,0.7fr)_minmax(0,1.3fr)] lg:gap-20">
      <div>
        <h2 id="not-heading" class="h2 max-w-[14ch]">What this roadmap is not.</h2>
      </div>
      <ul class="border-t border-border-strong">
        {
          [
            'A release schedule. Stage order shows dependency and priority, not dates.',
            'A full price list. Probe has three plans; Gate and Guard are in development; Box is planned not sold and have no price.',
            'A self-serve console. Probe activation is manual; no account or API key is created online.',
            'A platform claim. Each module stands on its own verified scope.',
          ].map((item, index) => (
            <li class="grid grid-cols-[36px_1fr] gap-4 border-b border-border py-4">
              <span class="mono text-[11px] tracking-[0.06em] text-muted">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="note block text-[14px] leading-6 text-ink-2">{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
