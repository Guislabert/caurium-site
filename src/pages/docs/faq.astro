---
import BaseLayout from '@/layouts/BaseLayout.astro';
import DocsShell from '@/components/DocsShell.astro';
import { FAQ } from '@/content/faq';

const FAQ_SCHEMA = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<BaseLayout
  title="FAQ"
  description="Answers about Caurium availability, Probe prices, regions, status data, refunds and how to report a security concern during the private preview."
  path="/docs/faq/"
  ogImage="/og/docs.png"
  ogAlt="Caurium frequently asked questions."
  structuredData={FAQ_SCHEMA}
>
  <DocsShell
    current="/docs/faq/"
    title="Frequently asked questions"
    description="Short answers about what exists, what does not, and what Caurium will not claim. Every answer describes the current public state or an intended design."
  >
    <p>
      These are the questions a reader should ask before relying on a page. If an answer is not here,
      the <a href="/trust/">claims register</a> records what is verified and what is still a gap.
    </p>

    <div class="mt-8 border-t border-border-strong">
      {
        FAQ.map((item, index) => (
          <details class="group border-b border-border">
            <summary class="flex min-h-14 cursor-pointer list-none items-start justify-between gap-4 py-4 text-[15px] font-medium leading-6 text-ink [&::-webkit-details-marker]:hidden">
              <span class="grid flex-1 grid-cols-[28px_1fr] gap-2">
                <span class="mono pt-0.5 text-[11px] tracking-[0.06em] text-muted">
                  {String(index + 1).padStart(2, '0')}
                </span>
                {item.question}
              </span>
              <span
                aria-hidden="true"
                class="mono pt-0.5 text-[13.5px] text-muted transition-transform group-open:rotate-45"
              >
                +
              </span>
            </summary>
            <p class="mt-3 pl-9 text-[14px] leading-6 text-muted">{item.answer}</p>
          </details>
        ))
      }
    </div>

    <h2 id="next">Where to go next</h2>
    <p>
      Read the <a href="/docs/product-stages/">stage dictionary</a> before interpreting any product
      label. The <a href="/docs/security/">security boundaries</a> page describes the access, credential
      and logging model. The <a href="/trust/">claims register</a> lists every public claim with its
      evidence status.
    </p>
  </DocsShell>
</BaseLayout>
