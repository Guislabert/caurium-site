---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import Features2 from '~/components/widgets/Features2.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import StructuredData from '~/components/common/StructuredData.astro';

import { SITE, METADATA, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';

const metadata = {
  title: 'Edge network and API platform',
  description: 'AsterLyn routes, secures, and observes API traffic across regions from a single control plane.',
  openGraph: { type: 'website' },
};

const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
    ...(METADATA?.twitter?.handle ? { sameAs: [`https://x.com/${METADATA.twitter.handle.replace(/^@/, '')}`] } : {}),
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <Hero
    badge="AsterLyn Edge"
    tagline="Edge network & API platform"
    title="The edge network for modern APIs."
    subtitle="Route, secure, and observe API traffic across regions — from a single control plane."
    actions={[
      { variant: 'primary', text: 'Talk to us', href: '/contact', icon: 'tabler:arrow-right' },
      { text: 'Read the docs', href: 'https://docs.asterlyn.io' },
    ]}
  />

  <Features
    id="platform"
    tagline="Platform"
    title="One control plane. Three layers."
    subtitle="AsterLyn sits between your origin and your users, so routing, access, and telemetry are configured once instead of in every region."
    columns={2}
    items={[
      {
        title: 'Edge routing',
        description:
          'Send each request to the nearest healthy region, with policy-based failover when a region degrades.',
        icon: 'tabler:route',
      },
      {
        title: 'API gateway',
        description:
          'Terminate TLS, validate credentials, apply rate limits, and enforce request policies at the edge.',
        icon: 'tabler:api',
      },
      {
        title: 'Observability',
        description:
          'Traces, structured logs, and request metrics for every route, without shipping a separate agent to each origin.',
        icon: 'tabler:activity',
      },
      {
        title: 'Identity & access',
        description: 'Scoped API keys, per-environment credentials, and an audit trail for every control-plane change.',
        icon: 'tabler:key',
      },
    ]}
  />

  <Steps
    id="how-it-works"
    tagline="How it works"
    title="From origin to edge in three steps"
    subtitle="Keep your existing HTTP services. AsterLyn becomes the front door."
    items={[
      {
        title: 'Connect your origin',
        description: 'Point AsterLyn at an existing HTTP service. No rewrite, no SDK, no sidecar.',
        icon: 'tabler:plug-connected',
      },
      {
        title: 'Define routes and policies',
        description:
          'Declare regions, health checks, authentication, and rate limits in the dashboard or through the API.',
        icon: 'tabler:adjustments-horizontal',
      },
      {
        title: 'Ship and observe',
        description: 'Traffic is served from the nearest healthy region. Traces and logs stream back to one place.',
        icon: 'tabler:chart-line',
      },
    ]}
    callToAction={{
      text: 'Read the quickstart',
      href: 'https://docs.asterlyn.io/guides/getting-started/',
      icon: 'tabler:arrow-right',
    }}
  />

  <Features2
    id="regions"
    tagline="Global footprint"
    title="Regional routing without regional silos"
    subtitle="AsterLyn is built around independent regional points of presence, with a shared control plane above them."
    columns={2}
    items={[
      {
        title: 'North America',
        description: 'Edge presence for teams serving users across the US and Canada.',
        icon: 'tabler:map-pin',
      },
      {
        title: 'Europe',
        description: 'Regional routing and data handling for European traffic.',
        icon: 'tabler:map-pin',
      },
      {
        title: 'Asia Pacific',
        description: 'Low-latency entry points for users across East and Southeast Asia.',
        icon: 'tabler:map-pin',
      },
      {
        title: 'Oceania',
        description: 'Regional coverage for Australia and New Zealand.',
        icon: 'tabler:map-pin',
      },
    ]}
  />

  <FAQs
    id="faq"
    tagline="FAQ"
    title="Questions before you start"
    collapsible={true}
    schema={true}
    items={[
      {
        title: 'What is AsterLyn Edge?',
        description:
          'AsterLyn Edge is a control plane for routing, securing, and observing API traffic across regions. It sits in front of your existing HTTP services.',
      },
      {
        title: 'Do I need to change my application?',
        description:
          'No. Point AsterLyn at an existing origin and keep your application code as it is. Routing and access policies live in AsterLyn.',
      },
      {
        title: 'How does regional routing work?',
        description:
          'Each request is matched against your routes and sent to the nearest healthy region. If a region fails its health checks, traffic moves to the next eligible region according to your policy.',
      },
      {
        title: 'Where is my data stored?',
        description:
          'Control-plane data is stored centrally. Request logs and traces are retained per your plan and can be scoped to a region. Contact us for data-handling details before you onboard.',
      },
      {
        title: 'How do I get access?',
        description:
          'AsterLyn is onboarding teams gradually. Send us a short note about your traffic profile and regions, and we will follow up.',
      },
    ]}
  />

  <CallToAction
    title="Put your APIs on the edge"
    subtitle="Tell us what you run today and where your users are. We will map it to a regional setup."
    actions={[
      {
        variant: 'primary',
        text: 'Talk to us',
        href: '/contact',
        icon: 'tabler:arrow-right',
      },
      { text: 'Read the docs', href: 'https://docs.asterlyn.io' },
    ]}
    layout="banner"
  />
</Layout>
