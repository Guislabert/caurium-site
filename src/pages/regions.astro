---
import CauriumLayout from '~/layouts/CauriumLayout.astro';
import PageHero from '~/components/caurium/PageHero.astro';
import SectionHead from '~/components/caurium/SectionHead.astro';
import RegionGrid from '~/components/caurium/RegionGrid.astro';
import CTA from '~/components/caurium/CTA.astro';

const metadata = {
  title: 'Regions',
  description:
    'Five live Caurium regions — Germany, the United States, Singapore, Japan, and Australia — plus new regions delivered on request.',
};

const expansion = [
  {
    title: 'Tell us where',
    text: 'A city or country, the latency target, and any data-residency requirement. A short call is enough.',
  },
  {
    title: 'Capacity review',
    text: 'We check provider availability, network path, and whether the region can meet the same operating standard as the live five.',
  },
  {
    title: 'Deliver in 2–4 weeks',
    text: 'Provisioning, monitoring, backups, and a documented region profile. If it cannot be done properly, we will say so.',
  },
];
---

<CauriumLayout metadata={metadata}>
  <PageHero
    eyebrow="Regions"
    title="Five regions today. More on request."
    text="Enough coverage for Europe, North America, and Asia Pacific without pretending to be a global CDN. Each region is operated to the same standard, with its own monitoring, backups, and runbook."
    actions={[{ text: 'Ask about a region', href: '/contact' }]}
    aside={[
      { label: 'Live', value: '5 regions' },
      { label: 'Expansion', value: '2–4 weeks' },
      { label: 'Data residency', value: 'EU option available' },
      { label: 'Status', value: 'status.caurium.tech' },
    ]}
  />

  <section class="section">
    <div class="u-container">
      <SectionHead
        eyebrow="Live footprint"
        title="Where Caurium runs today."
        text="A region is not a DNS entry. Each one has its own ingress, health checks, backup path, and on-call runbook."
        split
      />
      <RegionGrid />
    </div>
  </section>

  <section class="section section--paper">
    <div class="u-container">
      <SectionHead
        eyebrow="Expansion"
        title="Adding a region is a process, not a promise."
        text="We would rather deliver one region properly than list twenty on a map."
      />
      <div class="steps steps--3">
        {
          expansion.map((step, index) => (
            <div class="step" data-reveal style={`--reveal-delay: ${index * 60}ms`}>
              <span class="step__num">{String(index + 1).padStart(2, '0')}</span>
              <h3 class="step__title">{step.title}</h3>
              <p class="step__text">{step.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="u-container split">
      <div>
        <SectionHead eyebrow="Data residency" title="Where your data sits, in writing." />
      </div>
      <div style="display: grid; gap: 1rem">
        <div class="note-box" data-reveal>
          <h3>EU workloads</h3>
          <p>Germany is the default for EU data residency. Backups, logs, and standby copies can be kept inside the EU on request.</p>
        </div>
        <div class="note-box" data-reveal style="--reveal-delay: 60ms">
          <h3>Cross-region copies</h3>
          <p>Guard replicates to a second region. If your policy forbids leaving a jurisdiction, we will scope replication accordingly and document the trade-off.</p>
        </div>
        <div class="note-box" data-reveal style="--reveal-delay: 120ms">
          <h3>Subprocessors</h3>
          <p>The underlying cloud provider for each region is listed in your plan and in the trust page. We do not hide infrastructure vendors behind a generic “cloud” label.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="u-container">
      <CTA
        title="Need a region that is not on the list?"
        text="Tell us the city, the latency target, and the data requirement. We will confirm whether it can be delivered to the same standard."
        primary={{ text: 'Ask about a region', href: '/contact' }}
        secondary={{ text: 'See pricing', href: '/pricing' }}
      />
    </div>
  </section>
</CauriumLayout>
