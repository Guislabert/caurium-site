---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'About',
  description: 'AsterLyn builds edge routing and API infrastructure for teams that serve users across regions.',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="About"
    title="Infrastructure for teams that run APIs everywhere."
    subtitle="AsterLyn is an edge network and API platform. We focus on the layer between your origin and your users: routing, access, and the telemetry that tells you what actually happened."
  />

  <Features2
    title="What we optimize for"
    subtitle="Three principles shape the platform. They are also the questions we ask before adding a feature."
    columns={2}
    items={[
      {
        title: 'Keep the origin boring',
        description:
          'Your application should not need to know which region served a request. Routing, health checks, and failover belong in the platform, not in every service.',
        icon: 'tabler:server',
      },
      {
        title: 'Make behavior observable',
        description:
          'A route without traces is a guess. Every request should produce enough telemetry to explain latency, errors, and regional shifts without a separate pipeline.',
        icon: 'tabler:activity',
      },
      {
        title: 'Prefer explicit policy',
        description:
          'Access rules, rate limits, and regional preferences should be written down and versioned, not inferred from a dashboard click.',
        icon: 'tabler:file-code',
      },
      {
        title: 'Design for failure',
        description:
          'Regions fail. Networks partition. The control plane should make the next eligible path obvious and keep the failure contained.',
        icon: 'tabler:shield-check',
      },
    ]}
  />

  <CallToAction
    title="Work with us"
    subtitle="If your API traffic crosses regions, we would like to hear how you run it today."
    actions={[
      { variant: 'primary', text: 'Contact us', href: '/contact', icon: 'tabler:arrow-right' },
      { text: 'Read the docs', href: 'https://docs.asterlyn.io' },
    ]}
  />
</Layout>
