---
import CauriumLayout from '~/layouts/CauriumLayout.astro';
import PageHero from '~/components/caurium/PageHero.astro';
import SectionHead from '~/components/caurium/SectionHead.astro';
import FeatureGrid from '~/components/caurium/FeatureGrid.astro';
import Plan from '~/components/caurium/Plan.astro';
import FAQ from '~/components/caurium/FAQ.astro';
import CTA from '~/components/caurium/CTA.astro';

const metadata = {
  title: 'Caurium Base — managed hosting',
  description:
    'Managed hosting for teams running services abroad. Provisioning, patching, backups, monitoring, and runbooks in five regions.',
};

const features = [
  {
    title: 'Provisioning from a written recipe',
    text: 'OS, runtime, TLS, reverse proxy, log rotation, and firewall — built the same way every time and documented for your team.',
  },
  {
    title: 'Patching with a rollback path',
    text: 'A weekly patch window, with security fixes applied out of band and a tested way back if an update misbehaves.',
  },
  {
    title: 'Backups that get restored',
    text: 'Daily encrypted backups with a scheduled restore test. A backup that has never been restored is a hope, not a control.',
  },
  {
    title: 'Monitoring before handover',
    text: 'HTTP, resource, disk, and certificate checks are wired into alerts before we call the environment live.',
  },
  {
    title: 'Runbooks you own',
    text: 'Deploy, rollback, and recovery procedures are written down and handed over. They are yours, not ours.',
  },
  {
    title: 'An exit that works',
    text: 'Credentials, backups, and documentation are available on request. There is no exit fee and no proprietary runtime to unwind.',
  },
];

const steps = [
  {
    title: 'Scope call',
    text: 'Thirty minutes on the stack, the regions that matter, data handling, and what happens if a region fails.',
  },
  {
    title: 'Written plan',
    text: 'Architecture, monthly cost, exclusions, and a timeline. You approve it before anything is provisioned.',
  },
  {
    title: 'Deploy',
    text: 'One to two weeks, staged. Monitoring and backups are live before traffic is cut over.',
  },
  {
    title: 'Operate',
    text: 'Patch, backup, and alert cadence, plus a monthly health report and a named support channel.',
  },
];

const faqs = [
  {
    q: 'Do I have to move my application?',
    a: 'No. If it runs on a normal Linux host or container, we can usually take over the existing environment or rebuild it in place. Applications that depend on a managed platform need a short compatibility review first.',
  },
  {
    q: 'Which cloud providers do you use?',
    a: 'Reputable providers in each region. The specific provider, region, and instance class are written into your plan so there is no ambiguity about where your service runs.',
  },
  {
    q: 'What happens if I want to leave?',
    a: 'You receive credentials, a current backup, and the runbooks. We help with a migration window and do not charge an exit fee.',
  },
  {
    q: 'Is 24/7 support included?',
    a: 'Not by default. Business-hours support is included in every plan. Out-of-hours on-call is a separate agreement with a defined escalation path.',
  },
  {
    q: 'Can you sign a DPA?',
    a: 'Yes, for business customers. We document where data is stored, which subprocessors are involved, and how long logs are retained.',
  },
];
---

<CauriumLayout metadata={metadata}>
  <PageHero
    eyebrow="Caurium Base"
    title="Hosting that behaves like infrastructure."
    text="We take responsibility for the layer beneath your application: the host, the certificates, the backups, the alerts, and the runbook nobody wants to write at 2am."
    actions={[
      { text: 'Talk to us', href: '/contact' },
      { text: 'See pricing', href: '#pricing', variant: 'ghost' },
    ]}
    aside={[
      { label: 'Regions', value: '5 live, more on request' },
      { label: 'Deployment', value: '1–2 weeks after scope' },
      { label: 'Backups', value: 'Daily, encrypted, tested' },
      { label: 'Support', value: 'Business hours, named channel' },
    ]}
  />

  <section class="section">
    <div class="u-container">
      <SectionHead
        eyebrow="What you get"
        title="The unglamorous work, done properly."
        text="Base is not a control panel with a deploy button. It is a small team taking ownership of the environment your service runs on."
        split
      />
      <FeatureGrid items={features} />
    </div>
  </section>

  <section class="section section--paper">
    <div class="u-container">
      <SectionHead
        eyebrow="Engagement"
        title="A predictable path from call to handover."
        text="Most environments are live within two weeks. Nothing is provisioned before the scope and cost are in writing."
      />
      <div class="steps">
        {
          steps.map((step, index) => (
            <div class="step" data-reveal style={`--reveal-delay: ${index * 60}ms`}>
              <span class="step__num">{String(index + 1).padStart(2, '0')}</span>
              <h3 class="step__title">{step.title}</h3>
              <p class="step__text">{step.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="u-container split">
      <div>
        <SectionHead eyebrow="Boundaries" title="What is included — and what is not." />
      </div>
      <div style="display: grid; gap: 1rem">
        <div class="note-box" data-reveal>
          <h3>Included</h3>
          <p>Runtime and host management, TLS, patching, encrypted backups, monitoring, alert routing, runbooks, and a monthly health report.</p>
        </div>
        <div class="note-box" data-reveal style="--reveal-delay: 60ms">
          <h3>Not included</h3>
          <p>Application code changes, feature development, database tuning beyond standard practice, and cloud pass-through costs — those are billed at cost with your approval.</p>
        </div>
        <div class="note-box" data-reveal style="--reveal-delay: 120ms">
          <h3>Not offered</h3>
          <p>Caurium does not provide VPN, proxy, or circumvention services, and does not host anonymous tunnel endpoints.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--lav" id="pricing">
    <div class="u-container">
      <SectionHead
        eyebrow="Base pricing"
        title="Monthly, written down."
        text="Prices exclude tax. A one-time €500 setup fee applies to new Base environments; cloud pass-through costs are billed at cost."
      />
      <div class="plans">
        <Plan
          title="Single"
          price="€149"
          note="One region, one environment. Suitable for an internal tool or a first deployment abroad."
          features={['1 region, 1 environment', 'Daily backups, 7-day retention', 'Business-hours support', 'Monthly health report']}
          href="/contact"
          cta="Start with Single"
        />
        <Plan
          title="Multi"
          price="€299"
          featured
          badge="Recommended"
          note="Two regions, two environments. The usual shape for a customer-facing service."
          features={[
            '2 regions, 2 environments',
            'Daily backups, 30-day retention',
            '4-business-hour response',
            'Quarterly restore test',
          ]}
          href="/contact"
          cta="Start with Multi"
        />
        <Plan
          title="Scale"
          price="€499"
          note="Three regions, up to five environments, named engineer."
          features={[
            '3 regions, up to 5 environments',
            'Daily backups, 30-day retention',
            '1-business-hour response',
            'Monthly restore test',
          ]}
          href="/contact"
          cta="Start with Scale"
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="u-container">
      <SectionHead eyebrow="FAQ" title="Base, in practice." />
      <FAQ items={faqs} />
    </div>
  </section>

  <section class="section section--tight">
    <div class="u-container">
      <CTA
        title="Send us the stack you run today."
        text="A short note about your application, regions, and support expectations is enough to start. We will reply with a written assessment."
        primary={{ text: 'Talk to us', href: '/contact' }}
        secondary={{ text: 'Read the docs', href: 'https://docs.caurium.tech' }}
      />
    </div>
  </section>
</CauriumLayout>
