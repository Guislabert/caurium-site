---
import CauriumLayout from '~/layouts/CauriumLayout.astro';

interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;
---

<CauriumLayout metadata={{ title: frontmatter.title, description: frontmatter.description }}>
  <section class="page-hero">
    <div class="page-hero__glow" aria-hidden="true"></div>
    <div class="u-container">
      <div class="page-hero__copy">
        <p class="u-eyebrow">Legal</p>
        <h1 class="u-display-lg">{frontmatter.title}</h1>
        {frontmatter.description && <p class="u-lead">{frontmatter.description}</p>}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="u-container">
      <article class="prose">
        <slot />
      </article>
    </div>
  </section>
</CauriumLayout>
