---
export interface Props {
  title: string;
  tone?: 'note' | 'warning' | 'danger' | 'info';
}

const TONE_CLASSES: Record<string, string> = {
  note: 'border-border bg-paper',
  info: 'border-[#bcd7fb] bg-accent-soft',
  warning: 'border-[#e8cfae] bg-[#fdf6ec]',
  danger: 'border-[#efc9c9] bg-[#fdf1f1]',
};

const { title, tone = 'note' } = Astro.props;
---

<div class={`rounded-[10px] border p-4 md:p-5 ${TONE_CLASSES[tone]}`}>
  <p class="text-sm font-medium leading-6">{title}</p>
  <div class="mt-1 text-[14px] leading-6 text-muted">
    <slot />
  </div>
</div>
