---
import Logo from '@/components/Logo.astro';
import { CONTACT, FOOTER_LINKS, SITE } from '@/content/site';

const CONTACT_LINKS = [
  { label: 'Security', address: CONTACT.security, note: 'vulnerability reports' },
  { label: 'Support', address: CONTACT.support, note: 'accounts and activation' },
  { label: 'Privacy', address: CONTACT.privacy, note: 'data requests' },
];

/** Build time, not visit time: the footer states one static year. */
const YEAR = new Date().getUTCFullYear();
---

<footer class="site-footer">
  <div class="container-page py-14 md:py-20">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,2.2fr)] lg:gap-16">
      <div>
        <Logo />
        <p class="mt-5 max-w-xs text-[14px] leading-6 text-muted">{SITE.tagline}</p>
        <p class="mono mt-6 max-w-sm border-l border-accent pl-3 text-[12px] leading-5 text-muted">
          {SITE.stageNote}
        </p>
      </div>

      <div class="grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-4">
        {
          FOOTER_LINKS.map((group) => (
            <nav aria-label={group.title}>
              <p class="eyebrow mb-4">{group.title}</p>
              <ul>
                {group.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="text-[14px] text-ink-2 transition-colors hover:text-accent-ink"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>
    </div>

    <div class="mt-14 border-t border-border pt-6">
      <div
        class="flex flex-col gap-3 text-[13px] text-muted sm:flex-row sm:items-center sm:justify-between"
      >
        <p>© {YEAR} Caurium. All rights reserved.</p>
        <p class="mono text-[11px] uppercase tracking-[0.06em]">
          Static site · Free preview · No first-party tracking
        </p>
      </div>
      <p class="note mt-4 text-[13px] leading-5 text-muted">
        Product availability is listed per product. Nothing on this site is a live service unless a
        product page says so.
      </p>
      <ul class="mt-5 flex flex-col text-[13px] text-muted sm:flex-row sm:flex-wrap sm:gap-x-6">
        {
          CONTACT_LINKS.map((item) => (
            <li class="flex min-h-9 flex-wrap items-center gap-x-1.5">
              <span class="mono text-[11px] uppercase tracking-[0.06em] text-muted">
                {item.label}
              </span>{' '}
              <a
                href={`mailto:${item.address}`}
                class="inline-flex min-h-9 items-center underline decoration-border-strong underline-offset-2 hover:text-accent-ink"
              >
                {item.address}
              </a>{' '}
              <span class="text-muted">— {item.note}</span>
            </li>
          ))
        }
      </ul>
      <p class="mono mt-3 text-[11px] uppercase tracking-[0.06em] text-muted">
        Content reviewed 29 Oct 2026 ·{' '}
        <a
          href="/build-log/"
          class="inline-flex min-h-9 items-center underline decoration-border-strong underline-offset-2 hover:text-accent-ink"
        >
          Build log
        </a>
      </p>
    </div>
  </div>
</footer>
