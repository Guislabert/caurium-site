---
import ProductGlyph from '@/components/ProductGlyph.astro';
import ProductStageBadge from '@/components/ProductStageBadge.astro';
import type { ProductRecord } from '@/content/products';

export interface Props {
  product: ProductRecord;
  index: number;
}

const { product, index } = Astro.props;
---

<a
  href={`/products/${product.slug}/`}
  class="product-card group"
  aria-label={`View ${product.name} — ${product.title}`}
>
  <div class="product-card__body">
    <div class="flex items-start justify-between gap-4">
      <ProductGlyph id={product.id} class="h-11 w-11 text-foreground" />
      <ProductStageBadge stage={product.stage} />
    </div>

    <div class="mt-8 flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <h3 class="text-[26px] leading-none tracking-[-0.03em]">{product.name}</h3>
      <span class="mono text-[11px] uppercase tracking-[0.06em] text-muted">{product.role}</span>
    </div>

    <p class="mt-4 text-[15.5px] leading-6">{product.title}</p>
    <p class="mt-2 text-[14px] leading-6 text-muted">{product.summary}</p>
    <p class="mt-4 text-[13.5px] leading-5 text-ink-2">
      <span class="mono mr-2 text-[11px] uppercase tracking-[0.06em] text-muted">For</span>
      {product.forLine}
    </p>

    <div class="mt-7 flex-1"></div>

    <div class="flex items-center justify-between gap-4 border-t border-border pt-3.5">
      <span class="mono text-[11px] uppercase tracking-[0.06em] text-muted">Boundary</span>
      <span class="text-right text-[12.5px] leading-5 text-muted">{product.boundaryTarget}</span>
    </div>

    <div class="mt-4 flex items-center justify-between gap-4">
      <span class="link-arrow">
        View {product.name}
        <span aria-hidden="true">→</span>
      </span>
      <span class="mono text-[11px] uppercase tracking-[0.06em] text-muted">
        Fig. {String(index + 2).padStart(2, '0')}
      </span>
    </div>
  </div>
</a>
