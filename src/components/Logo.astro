---
import { SITE } from 'astrowind:config';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<span class:list={['brand', className]}>
  <svg class="brand__mark" viewBox="0 0 32 32" fill="none" aria-hidden="true">
    <rect x="1" y="1" width="30" height="30" rx="9" fill="#0B1B3F"></rect>
    <path
      d="M21.4 9.9a8.2 8.2 0 1 0 0 12.2"
      stroke="#F6F4EE"
      stroke-width="3"
      stroke-linecap="round"></path>
    <circle cx="23.6" cy="16" r="2.2" fill="#C9E265"></circle>
  </svg>
  <span class="brand__name">{SITE?.name}</span>
</span>
