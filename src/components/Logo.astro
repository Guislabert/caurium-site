---
import { SITE } from 'astrowind:config';
---

<span class="flex items-center gap-2 self-center ml-2 rtl:ml-0 rtl:mr-2">
  <svg
    class="w-7 h-7 text-primary"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 2.8 3.6 21.2h16.8L12 2.8Z"></path>
    <circle cx="12" cy="14.2" r="2.1"></circle>
  </svg>
  <span class="text-2xl md:text-xl font-bold text-gray-900 whitespace-nowrap dark:text-white">
    {SITE?.name}
  </span>
</span>
