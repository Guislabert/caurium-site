---
import Logo from '~/components/Logo.astro';
import { headerData } from '~/navigation';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

function isActive(href: string) {
  if (!href.startsWith('/')) return false;
  const clean = href.replace(/\/+$/, '') || '/';
  return clean === '/' ? path === '/' : path === clean || path.startsWith(`${clean}/`);
}
---

<header class="site-header">
  <div class="u-container site-header__inner">
    <a href="/" aria-label="Caurium home">
      <Logo />
    </a>

    <nav class="site-nav" aria-label="Main navigation">
      {
        headerData.links.map((link) => (
          <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
            {link.text}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <a class="btn btn--primary btn--sm" href="/contact">
        Talk to us <span class="arrow" aria-hidden="true">→</span>
      </a>
      <button
        type="button"
        class="nav-toggle"
        aria-label="Toggle navigation"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-nav-toggle
      >
        <span class="nav-toggle__bars" aria-hidden="true">
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav" data-mobile-nav>
    {
      headerData.links.map((link) => (
        <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
          {link.text}
        </a>
      ))
    }
    <a class="btn btn--primary" href="/contact">Talk to us</a>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-mobile-nav]');

  toggle?.addEventListener('click', () => {
    const open = panel?.classList.toggle('is-open') ?? false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
