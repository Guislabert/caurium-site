---
interface Props {
  items: { q: string; a: string }[];
}

const { items } = Astro.props;
---

<div class="faqs">
  {
    items.map((item, index) => (
      <details class="faq" open={index === 0}>
        <summary>{item.q}</summary>
        <div class="faq__answer">{item.a}</div>
      </details>
    ))
  }
</div>
