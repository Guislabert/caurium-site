---
import Button from '~/components/caurium/Button.astro';

interface Action {
  text: string;
  href: string;
  variant?: 'primary' | 'ghost' | 'dark';
}

interface AsideItem {
  label: string;
  value: string;
}

interface Props {
  eyebrow: string;
  title: string;
  text: string;
  actions?: Action[];
  aside?: AsideItem[];
}

const { eyebrow, title, text, actions = [], aside = [] } = Astro.props;
---

<section class="page-hero">
  <div class="page-hero__glow" aria-hidden="true"></div>
  <div class="u-container page-hero__inner">
    <div class="page-hero__copy">
      <p class="u-eyebrow">{eyebrow}</p>
      <h1 class="u-display-lg">{title}</h1>
      <p class="u-lead">{text}</p>
      {
        actions.length > 0 && (
          <div class="hero__actions">
            {actions.map((action) => (
              <Button href={action.href} variant={action.variant || 'primary'} arrow={action.variant !== 'ghost'}>
                {action.text}
              </Button>
            ))}
          </div>
        )
      }
    </div>

    {
      aside.length > 0 && (
        <div class="page-hero__aside">
          {aside.map((item) => (
            <div>
              <span class="u-mono">{item.label}</span>
              <br />
              <strong>{item.value}</strong>
            </div>
          ))}
        </div>
      )
    }
  </div>
</section>
