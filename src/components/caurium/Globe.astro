---
const regions = [
  { name: 'Germany', code: 'de', lat: 51.1, lon: 10.4 },
  { name: 'United States', code: 'us', lat: 39.8, lon: -98.6 },
  { name: 'Singapore', code: 'sg', lat: 1.35, lon: 103.82 },
  { name: 'Japan', code: 'jp', lat: 36.2, lon: 138.25 },
  { name: 'Australia', code: 'au', lat: -25.27, lon: 133.78 },
];
---

<div class="globe-card" role="group" aria-label="Illustrative rotating globe with five Caurium regions">
  <div class="globe-card__bar">
    <span>caurium / network</span>
    <span class="console__dots" aria-hidden="true"><i></i><i></i><i></i></span>
  </div>

  <div class="globe-card__body">
    <div class="globe-wrap">
      <canvas class="globe-canvas" data-globe aria-hidden="true"></canvas>
    </div>
    <ul class="globe-legend">
      {
        regions.map((region) => (
          <li>
            <span class="globe-legend__dot" aria-hidden="true" />
            <span class="globe-legend__name">{region.name}</span>
            <span class="globe-legend__code">{region.code}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="globe-card__foot">
    <span>5 / 5 regions healthy</span>
    <span>checks every 60s</span>
  </div>
</div>
<p class="console-note">Illustrative network view · not live data</p>

<script define:vars={{ regions }}>
  (() => {
    const canvas = document.querySelector('[data-globe]');
    if (!(canvas instanceof HTMLCanvasElement)) return;

    const context = canvas.getContext('2d');
    if (!context) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const TAU = Math.PI * 2;
    const TILT = -0.32;
    const DOTS = 640;

    let width = 0;
    let height = 0;
    let radius = 0;
    let frame = 0;
    let angle = -0.6;
    let visible = true;
    let last = 0;

    const points = [];
    for (let i = 0; i < DOTS; i += 1) {
      const y = 1 - (i / (DOTS - 1)) * 2;
      const ring = Math.sqrt(Math.max(0, 1 - y * y));
      const theta = i * 2.399963229728653;
      points.push({ x: Math.cos(theta) * ring, y, z: Math.sin(theta) * ring });
    }

    const nodes = regions.map((region) => {
      const lat = (region.lat * Math.PI) / 180;
      const lon = (region.lon * Math.PI) / 180;
      return {
        code: region.code,
        x: Math.cos(lat) * Math.cos(lon),
        y: Math.sin(lat),
        z: Math.cos(lat) * Math.sin(lon),
      };
    });

    function project(point, rotation) {
      const cos = Math.cos(rotation);
      const sin = Math.sin(rotation);
      const x = point.x * cos + point.z * sin;
      const z = -point.x * sin + point.z * cos;
      const cosTilt = Math.cos(TILT);
      const sinTilt = Math.sin(TILT);
      const y = point.y * cosTilt - z * sinTilt;
      const depth = point.y * sinTilt + z * cosTilt;
      return { x, y, depth };
    }

    function resize() {
      const rect = canvas.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = rect.width;
      height = rect.height;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      context.setTransform(dpr, 0, 0, dpr, 0, 0);
      radius = Math.min(width, height) * 0.42;
      draw(0);
    }

    function draw(time) {
      context.clearRect(0, 0, width, height);

      const cx = width / 2;
      const cy = height / 2;

      const halo = context.createRadialGradient(cx, cy, radius * 0.2, cx, cy, radius * 1.25);
      halo.addColorStop(0, 'rgba(108, 76, 241, 0.22)');
      halo.addColorStop(0.65, 'rgba(108, 76, 241, 0.06)');
      halo.addColorStop(1, 'rgba(108, 76, 241, 0)');
      context.fillStyle = halo;
      context.beginPath();
      context.arc(cx, cy, radius * 1.25, 0, TAU);
      context.fill();

      for (const point of points) {
        const p = project(point, angle);
        const depth = (p.depth + 1) / 2;
        context.beginPath();
        context.fillStyle = `rgba(246, 244, 238, ${0.08 + depth * 0.42})`;
        context.arc(cx + p.x * radius, cy - p.y * radius, 0.55 + depth * 0.75, 0, TAU);
        context.fill();
      }

      for (const node of nodes) {
        const p = project(node, angle);
        if (p.depth < -0.15) continue;

        const x = cx + p.x * radius;
        const y = cy - p.y * radius;
        const pulse = reduceMotion ? 0 : (Math.sin(time / 700 + node.x * 3) + 1) / 2;

        context.beginPath();
        context.fillStyle = 'rgba(201, 226, 101, 0.16)';
        context.arc(x, y, 8 + pulse * 5, 0, TAU);
        context.fill();

        context.beginPath();
        context.fillStyle = '#c9e265';
        context.arc(x, y, 2.4, 0, TAU);
        context.fill();
      }
    }

    function tick(now) {
      if (!visible || reduceMotion) return;
      const delta = last ? Math.min(now - last, 64) : 16;
      last = now;
      angle += (delta / 1000) * 0.18;
      draw(now);
      frame = requestAnimationFrame(tick);
    }

    function start() {
      if (frame) return;
      last = 0;
      frame = requestAnimationFrame(tick);
    }

    function stop() {
      cancelAnimationFrame(frame);
      frame = 0;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        visible = entries[0]?.isIntersecting ?? true;
        if (visible) start();
        else stop();
      },
      { threshold: 0.05 }
    );
    observer.observe(canvas);

    new ResizeObserver(resize).observe(canvas);

    if (reduceMotion) draw(0);
    else start();
  })();
</script>
