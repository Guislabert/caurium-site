---
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  split?: boolean;
}

const { eyebrow, title, text, split = false } = Astro.props;
---

<div class:list={['section-head', split && 'section-head--split']}>
  <div>
    {eyebrow && <p class="u-eyebrow">{eyebrow}</p>}
    <h2 class="u-display-lg" data-reveal>{title}</h2>
  </div>
  {text && <p class="u-body" data-reveal>{text}</p>}
</div>
