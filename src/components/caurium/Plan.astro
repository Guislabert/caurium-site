---
import Button from '~/components/caurium/Button.astro';

interface Props {
  title: string;
  price: string;
  duration?: string;
  note?: string;
  features: string[];
  featured?: boolean;
  badge?: string;
  href: string;
  cta: string;
}

const { title, price, duration = '/month', note, features, featured = false, badge, href, cta } = Astro.props;
---

<div class:list={['plan', featured && 'plan--featured']}>
  <div class="plan__head">
    <h3 class="plan__title">{title}</h3>
    {badge && <span class="plan__badge">{badge}</span>}
  </div>

  <p class="plan__price">
    {price}<span class="plan__duration">{duration}</span>
  </p>

  {note && <p class="plan__note">{note}</p>}

  <ul class="plan__features">
    {features.map((feature) => <li>{feature}</li>)}
  </ul>

  <Button href={href} variant={featured ? 'primary' : 'ghost'}>{cta}</Button>
</div>
