---
import Button from '~/components/caurium/Button.astro';

interface Props {
  title: string;
  text: string;
  primary: { text: string; href: string };
  secondary?: { text: string; href: string };
}

const { title, text, primary, secondary } = Astro.props;
---

<div class="cta">
  <div>
    <h2 class="u-display-md">{title}</h2>
    <p>{text}</p>
  </div>
  <div class="cta__actions">
    <Button href={primary.href} variant="primary" arrow>{primary.text}</Button>
    {secondary && <Button href={secondary.href} variant="ghost">{secondary.text}</Button>}
  </div>
</div>
