---
import { footerData } from '~/navigation';

const email = 'hello' + '@' + 'caurium' + '.tech';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="u-container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a class="site-footer__word" href="/">Caurium</a>
        <p class="site-footer__tag">
          Managed infrastructure for teams going global. Deploy, monitor, and recover services in five regions.
        </p>
        <a class="link-arrow" href={`mailto:${email}`}>{email}</a>
      </div>

      {
        footerData.links.map((group) => (
          <div class="site-footer__col">
            <h3>{group.title}</h3>
            {group.links.map((link) => (
              <a href={link.href}>{link.text}</a>
            ))}
          </div>
        ))
      }
    </div>

    <div class="site-footer__bottom">
      <span>© {year} Caurium · caurium.tech</span>
      <span>Germany · United States · Singapore · Japan · Australia</span>
      <span>
        <a href="/privacy">Privacy</a>
        <span aria-hidden="true"> · </span>
        <a href="/terms">Terms</a>
      </span>
    </div>
  </div>
</footer>
