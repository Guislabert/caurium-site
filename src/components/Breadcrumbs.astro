---
export interface Crumb {
  label: string;
  href?: string;
}

export interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-[12px] text-muted">
  <ol class="flex flex-wrap items-center gap-x-2">
    <li>
      <a
        href="/"
        class="inline-flex min-h-9 items-center transition-colors hover:text-foreground">Home</a
      >
    </li>
    {
      items.map((item, index) => {
        const last = index === items.length - 1;
        return (
          <li class="flex items-center gap-2">
            <span aria-hidden="true" class="text-border-strong">
              /
            </span>
            {last || !item.href ? (
              <span
                aria-current={last ? 'page' : undefined}
                class="inline-flex min-h-9 items-center"
              >
                {item.label}
              </span>
            ) : (
              <a
                href={item.href}
                class="inline-flex min-h-9 items-center transition-colors hover:text-foreground"
              >
                {item.label}
              </a>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
