---
import MapArrow from '@/components/diagram/MapArrow.astro';
import MapDomainHeader from '@/components/diagram/MapDomainHeader.astro';
import MapNode from '@/components/diagram/MapNode.astro';
---

<figure>
  <div class="figure">
    <div class="figure__head">
      <p class="mono text-[11px] uppercase tracking-[0.06em] text-muted">
        Fig. 06 — Service boundaries
      </p>
      <div class="flex items-center gap-4 text-[12px] text-muted">
        <span class="inline-flex items-center gap-1.5">
          <span
            class="h-2.5 w-2.5 rounded-[2px] border border-border-strong bg-background"
            aria-hidden="true"></span>
          Current
        </span>
        <span class="inline-flex items-center gap-1.5">
          <span
            class="h-2.5 w-2.5 rounded-[2px] border border-dashed border-border-strong bg-background"
            aria-hidden="true"></span>
          Planned
        </span>
      </div>
    </div>

    <div class="figure__body grid-paper">
      <div class="grid gap-4 lg:grid-cols-3">
        <section aria-labelledby="arch-public" class="border border-border-strong p-4">
          <MapDomainHeader id="arch-public" title="Public website domain" state="Current" />
          <div class="mt-4">
            <MapNode title="Visitors" state="current" />
            <MapArrow />
            <MapNode title="Caurium website" detail="Cloudflare Workers, static HTML" state="current" />
            <MapArrow />
            <div class="grid grid-cols-2 gap-2">
              <MapNode title="Docs & roadmap" detail="Static pages" state="current" />
              <MapNode title="Sanitized status" detail="Read-only, optional" />
            </div>
          </div>
          <p class="mt-4 border-t border-border pt-3 text-[12px] leading-5 text-muted">
            No login, console, database or management route.
          </p>
        </section>

        <section aria-labelledby="arch-product" class="border border-dashed border-border-strong p-4">
          <MapDomainHeader id="arch-product" title="Product domain" state="Partial" />
          <div class="mt-4">
            <MapNode title="Authorized callers" detail="Per-caller credentials" />
            <MapArrow />
            <MapNode title="Gate" detail="Allow-listed upstream only" accent />
            <MapArrow />
            <MapNode title="Allowed upstream" detail="Authorized by the operator" />
            <div class="my-4 border-t border-dashed border-border"></div>
            <MapNode
              title="Fixed endpoints"
              detail="Probe, operator-authorized only"
              state="current"
              accent
            />
            <MapArrow />
            <MapNode title="Sanitized publisher" detail="No scan capability" state="current" />
            <div class="my-4 border-t border-dashed border-border"></div>
            <div class="grid grid-cols-2 gap-2">
              <MapNode title="Guard" detail="Internal operations" accent />
              <MapNode title="Box" detail="Invited instances" accent />
            </div>
          </div>
        </section>

        <section
          aria-labelledby="arch-management"
          class="border border-dashed border-border-strong p-4"
        >
          <MapDomainHeader id="arch-management" title="Management domain" state="Planned" />
          <div class="mt-4">
            <MapNode title="Administrators" detail="MFA, separated roles" />
            <MapArrow />
            <MapNode title="Identity & access" detail="Independent session" />
            <MapArrow />
            <MapNode title="Management panel" detail="Not on the public site" accent />
            <MapArrow />
            <MapNode title="Internal assets" detail="No public route" />
          </div>
          <p class="mt-4 border-t border-border pt-3 text-[12px] leading-5 text-muted">
            The public website has no call path into this domain.
          </p>
        </section>
      </div>

      <div
        class="mt-4 flex flex-col gap-2 border-t border-dashed border-border-strong pt-3 sm:flex-row sm:items-center sm:justify-between"
      >
        <p class="note text-[12px] leading-5 text-muted">
          <span class="mono uppercase tracking-[0.06em]">Outside this diagram:</span> separately
          operated networks. No topology, addresses, ports or credentials are published.
        </p>
        <p class="mono text-[11px] uppercase tracking-[0.06em] text-muted">
          Probe publishes the only live cross-domain output
        </p>
      </div>
    </div>

    <div class="figure__foot">
      <p class="note text-[12px] leading-5 text-muted">
        Reference architecture. Probe runs on the product side today; the dashed boxes and the
        management domain remain planned.
      </p>
    </div>
  </div>
  <figcaption class="figure-caption">
    Diagram of service boundaries. The public site explains the system; it does not operate it.
  </figcaption>
</figure>
