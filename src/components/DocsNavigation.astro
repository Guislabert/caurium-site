---
const DOC_NAV = [
  { href: '/docs/', label: 'Documentation' },
  { href: '/docs/overview/', label: 'System overview' },
  { href: '/docs/product-stages/', label: 'Product stages' },
  { href: '/docs/security/', label: 'Security boundaries' },
  { href: '/docs/faq/', label: 'FAQ' },
  { href: '/docs/glossary/', label: 'Glossary' },
];

export interface Props {
  current: string;
}

const { current } = Astro.props;
---

<nav
  aria-label="Documentation"
  class="min-w-0 max-w-full lg:sticky lg:top-[calc(var(--header)+var(--topbar)+16px)] lg:self-start"
>
  <p class="eyebrow mb-3">Docs</p>
  <ul class="docs-nav-list max-w-full border-l border-border">
    {
      DOC_NAV.map((item) => {
        const active = current === item.href;
        return (
          <li>
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class="docs-nav-link"
            >
              {item.label}
            </a>
          </li>
        );
      })
    }
  </ul>

  <div class="mt-6 hidden rounded-[10px] border border-border bg-paper p-3 lg:block">
    <p class="mono text-[11px] uppercase tracking-[0.06em] text-muted">Current state</p>
    <p class="mt-1.5 text-[12px] leading-5 text-muted">
      Probe is in private preview. Gate and Guard are in development; Box is planned.
    </p>
  </div>
</nav>
