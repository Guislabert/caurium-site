---
import type { ProductRecord } from '@/content/products';
import ProductGlyph from '@/components/ProductGlyph.astro';
import ProductStageBadge from '@/components/ProductStageBadge.astro';
import { STAGE_LABELS } from '@/content/products';

export interface Props {
  product: ProductRecord;
  figureNumber: number;
}

const { product, figureNumber } = Astro.props;

function reviewedDate(value: string) {
  return new Date(`${value}T00:00:00Z`).toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  });
}
---

<aside class="figure">
  <div class="figure__head">
    <p class="mono text-[11px] uppercase tracking-[0.06em] text-muted">
      Fig. {String(figureNumber).padStart(2, '0')} — Module record
    </p>
    <ProductStageBadge stage={product.stage} />
  </div>

  <div class="figure__body">
    <div class="flex items-start justify-between gap-4">
      <ProductGlyph id={product.id} class="h-14 w-14 text-foreground" />
      <span class="mono text-[11px] uppercase tracking-[0.06em] text-muted">{product.role}</span>
    </div>

    <dl class="mt-6 border-t border-border">
      <div class="flex items-center justify-between gap-4 border-b border-border py-2.5">
        <dt class="mono text-[11px] uppercase tracking-[0.06em] text-muted">Stage</dt>
        <dd class="text-[12px]">{STAGE_LABELS[product.stage]}</dd>
      </div>
      <div class="flex items-center justify-between gap-4 border-b border-border py-2.5">
        <dt class="mono text-[11px] uppercase tracking-[0.06em] text-muted">Surface</dt>
        <dd class="text-[12px] text-muted">None</dd>
      </div>
      <div class="flex items-center justify-between gap-4 border-b border-border py-2.5">
        <dt class="mono text-[11px] uppercase tracking-[0.06em] text-muted">Reviewed</dt>
        <dd class="text-[12px] text-muted">
          <time datetime={product.reviewedAt}>{reviewedDate(product.reviewedAt)}</time>
        </dd>
      </div>
    </dl>

    <div class="mt-6">
      <p class="mono text-[11px] uppercase tracking-[0.06em] text-muted">Intended flow</p>
      <ol class="mt-3 border-l border-border-strong pl-4">
        {
          product.workflow.map((step, index) => (
            <li class="relative pb-3 last:pb-0">
              <span
                aria-hidden="true"
                class="absolute -left-[21px] top-1.5 h-[7px] w-[7px] rounded-full border border-border-strong bg-paper"
              />
              <p class="mono text-[11px] uppercase tracking-[0.06em] text-muted">
                {String(index + 1).padStart(2, '0')}
              </p>
              <p class="mt-0.5 text-[12px] leading-4">{step.title}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>

  <div class="figure__foot">
    <p class="text-[12px] leading-5 text-muted">Illustrative record — not a live service.</p>
  </div>
</aside>
