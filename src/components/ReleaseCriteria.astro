---
export interface Props {
  criteria: string[];
  productName: string;
}

const { criteria, productName } = Astro.props;
---

<div>
  <ul class="border-t border-border-strong" aria-label={`${productName} release criteria`}>
    {
      criteria.map((criterion, index) => (
        <li class="grid grid-cols-[28px_1fr] gap-3 border-b border-border py-3.5">
          <span
            aria-hidden="true"
            class="mt-1 h-3.5 w-3.5 border border-border-strong bg-background"
          />
          <span class="text-[14px] leading-6 text-ink-2">
            <span class="mono mr-2 text-[11px] text-muted">
              {String(index + 1).padStart(2, '0')}
            </span>
            {criterion}
          </span>
        </li>
      ))
    }
  </ul>
  <p class="note mt-4 text-[13px] leading-5 text-muted">
    These are conditions to meet before the stage changes, not a schedule or a completed checklist.
    Each item requires recorded evidence.
  </p>
</div>
