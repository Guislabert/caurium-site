# Canonical origin used for metadata, sitemap and robots. Must be verified before production.
NEXT_PUBLIC_SITE_URL=https://caurium.tech

# "preview" emits noindex and a disallow-all robots.txt. Use "production" only after
# domain ownership, legal pages and deployment inputs have been verified.
NEXT_PUBLIC_SITE_ENV=preview

# Optional sanitized read-only status endpoint. Leave empty until a real publisher exists.
NEXT_PUBLIC_STATUS_URL=

# Origin of the Probe Worker that receives /start/ applications. Change it together
# with connect-src and form-action in public/_headers; a test fails if they disagree.
NEXT_PUBLIC_PROBE_URL=https://caurium-probe.caurium.workers.dev
