// Cloudflare Workers configuration for the static Astro build.
// Static files come from `dist/`; src/worker.ts only adds the www -> apex redirect.
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "caurium-site",
  "compatibility_date": "2026-10-28",
  "main": "src/worker.ts",
  // The apex is a custom domain on this Worker (created in the dashboard). `www`
  // needs its own custom-domain attachment: without one, DNS has nothing to answer
  // for it and src/worker.ts never sees the request it is supposed to redirect.
  "routes": [
    { "pattern": "www.caurium.tech", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Run the entry worker before serving assets, so the host check in
    // src/worker.ts can redirect www. Without this the asset layer answers first.
    "run_worker_first": true
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
