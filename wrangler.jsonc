// Cloudflare Workers configuration for deploying the static Next.js export.
// The Worker only serves the `out/` folder as assets; there is no runtime.
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "caurium-site",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
