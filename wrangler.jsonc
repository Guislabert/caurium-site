// Cloudflare Workers configuration for the static Astro build.
// Static files come from `dist/`; src/worker.ts only adds the www -> apex redirect.
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "caurium-site",
  "compatibility_date": "2026-10-28",
  "main": "src/worker.ts",
  // Both hostnames are custom domains on this Worker. They must be declared here,
  // not only in the dashboard: deploying a `routes` array replaces the Worker's
  // custom-domain set, and a hostname left out of it stops resolving.
  "routes": [
    { "pattern": "caurium.tech", "custom_domain": true },
    { "pattern": "www.caurium.tech", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Run the entry worker before serving assets, so the host check in
    // src/worker.ts can redirect www. Without this the asset layer answers first.
    "run_worker_first": true
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
